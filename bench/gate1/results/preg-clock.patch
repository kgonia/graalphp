diff --git a/src/main/java/pl/codeloom/php/runtime/PregClock.java b/src/main/java/pl/codeloom/php/runtime/PregClock.java
new file mode 100644
index 0000000..9c96a1d
--- /dev/null
+++ b/src/main/java/pl/codeloom/php/runtime/PregClock.java
@@ -0,0 +1,124 @@
+package pl.codeloom.php.runtime;
+
+import com.oracle.truffle.api.CompilerDirectives.TruffleBoundary;
+
+/**
+ * The inclusive time of the preg_* built-ins (-Dphp.pregclock=true): everything from a preg_* call's entry to its
+ * return (the subject's and pattern's conversion, the cache lookup, the native match, building $matches or the
+ * result) except the PHP code its replacement callbacks run, which is timed apart. A preg_* call inside a callback
+ * counts as preg time again. The flag is a static final: without it PcreFunctions registers the built-ins
+ * unwrapped, so nothing is left of this class.
+ *
+ * <p>The clock's own cost is measured in place, as {@link NativeClock} does: right after each exit the clock is read
+ * once more, and that back-to-back gap (about one clock reading and its bookkeeping, which is what a timed window
+ * holds of the clock itself) is kept apart, for the report to subtract. A thread's counters are its own; a server
+ * reads them around each request, which runs on one thread.
+ */
+public final class PregClock {
+    public static final boolean ENABLED = Boolean.getBoolean("php.pregclock");
+
+    /** Not inside a preg_* call. */
+    private static final int OUTSIDE = 0;
+    /** Inside a preg_* call, not in a callback. */
+    private static final int PREG = 1;
+    /** Inside a replacement callback's PHP code. */
+    private static final int CALLBACK = 2;
+
+    /** The functions timed: PcreFunctions passes these indices. */
+    public static final String[] NAMES = {"preg_match", "preg_match_all", "preg_replace", "preg_replace_callback",
+        "preg_split", "preg_quote", "preg_grep", "preg_last_error", "preg_last_error_msg"};
+    private static final int FUNCTIONS = NAMES.length;
+
+    private static final ThreadLocal<PregClock> CURRENT = ThreadLocal.withInitial(PregClock::new);
+
+    /** Nanoseconds inside preg_* calls, callbacks excluded, per function (PcreFunctions' index) and in all. */
+    public final long[] nanos;
+    public final long[] calls;
+    /** Nanoseconds in the callbacks' PHP code, and the callbacks called. */
+    public long callbackNanos;
+    public long callbacks;
+    /** The clock's own cost, measured in place: one back-to-back gap per timed window. */
+    public long overheadNanos;
+
+    private int state = OUTSIDE;
+    /** The function of the preg_* call running, while state is PREG or CALLBACK. */
+    private int function;
+    private long since;
+
+    private PregClock() {
+        nanos = new long[FUNCTIONS];
+        calls = new long[FUNCTIONS];
+    }
+
+    /** The current thread's counters so far. */
+    public static PregClock current() {
+        return CURRENT.get();
+    }
+
+    /** A copy of the counters, for a report's differences. */
+    public PregClock copy() {
+        PregClock copy = new PregClock();
+        System.arraycopy(nanos, 0, copy.nanos, 0, FUNCTIONS);
+        System.arraycopy(calls, 0, copy.calls, 0, FUNCTIONS);
+        copy.callbackNanos = callbackNanos;
+        copy.callbacks = callbacks;
+        copy.overheadNanos = overheadNanos;
+        return copy;
+    }
+
+    /** A preg_* call begins; returns the state it interrupts (encoded with the function), for {@link #exit}. */
+    @TruffleBoundary
+    public static int enter(int function) {
+        PregClock clock = CURRENT.get();
+        long now = System.nanoTime();
+        int outer = clock.state;
+        if (outer == CALLBACK) {
+            clock.callbackNanos += now - clock.since;
+        } else if (outer == PREG) {
+            // a preg_* built-in calling another directly: not done today, but the time stays preg time
+            clock.nanos[clock.function] += now - clock.since;
+        }
+        int encoded = outer | clock.function << 2;
+        clock.state = PREG;
+        clock.function = function;
+        clock.calls[function]++;
+        clock.since = now;
+        return encoded;
+    }
+
+    /** The preg_* call returns (or throws) to the state {@link #enter} returned. */
+    @TruffleBoundary
+    public static void exit(int encoded) {
+        PregClock clock = CURRENT.get();
+        long now = System.nanoTime();
+        clock.nanos[clock.function] += now - clock.since;
+        clock.state = encoded & 3;
+        clock.function = encoded >>> 2;
+        long after = System.nanoTime();
+        clock.overheadNanos += after - now;
+        clock.since = after;
+    }
+
+    /** A replacement callback's PHP code begins. */
+    @TruffleBoundary
+    public static void callbackEnter() {
+        PregClock clock = CURRENT.get();
+        long now = System.nanoTime();
+        clock.nanos[clock.function] += now - clock.since;
+        clock.state = CALLBACK;
+        clock.callbacks++;
+        clock.since = now;
+    }
+
+    /** The callback returned to its preg_* call. */
+    @TruffleBoundary
+    public static void callbackExit() {
+        PregClock clock = CURRENT.get();
+        long now = System.nanoTime();
+        clock.callbackNanos += now - clock.since;
+        clock.state = PREG;
+        long after = System.nanoTime();
+        clock.overheadNanos += after - now;
+        clock.since = after;
+    }
+}
